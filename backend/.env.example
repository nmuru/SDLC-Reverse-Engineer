OLLAMA_HOST=http://localhost:11434
MODEL_PROVIDER=ollama
# OLLAMA_MODEL defaults to the model configured in app/config.py

# Set to true only for the pipeline connectivity smoke test. In smoke-test mode
# phases use the isolated pipeline-smoke-test agent and make real model calls
# without loading repository analysis skills or repository references.
PIPELINE_SMOKE_TEST=false

# Runtime resource diagnostics for smoke/performance testing.
# Keep disabled for normal runs. Logs are written as JSONL under this directory.
RESOURCE_DIAGNOSTICS_ENABLED=false
RESOURCE_DIAGNOSTICS_INTERVAL_SECONDS=2
RESOURCE_DIAGNOSTICS_DIR=resource-diagnostics
